 "$schema": "./test-bm.schema.json",

 "dom_Clipboard_ConvertPageToMarkdown": {
  "url": "fixture:snippet.html",
  "scheduled": false,
  "requires": ["h1", "ul li", "table th", "a[href]", "img[src]"],
  "permissions": ["clipboard-read", "clipboard-write"],
  "dialogs": [{ "accept": true }],
  "timeout": 45000,
  "settle": 500,
  "steps": [
   { "run": true },
   { "wait": 4000 },
   { "expect": { "clipboard": "# One of each\r\n\r\nA small page, so the markdown a converter produces can be read in full.\r\n\r\n## A list\r\n\r\n-   First\r\n-   Second\r\n\r\n## A table\r\n\r\n| Stop | Name |\r\n| --- | --- |\r\n| 1 | Depot |\r\n| 2 | Main Street |\r\n\r\n## A link and an image\r\n\r\n[All practice pages](https://fixtures.test/index.html)\r\n\r\n![A placeholder badge](https://fixtures.test/badge.svg)" } }
  ]
 },

 "dom_Clipboard_MakeMdLinkList": {
  "url": "fixture:table.html",
  "scheduled": true,
  "requires": ["a", "h2"],
  "permissions": ["clipboard-read", "clipboard-write"],
  "dialogs": [{ "accept": true }],
  "steps": [
