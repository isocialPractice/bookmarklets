 "siteSpecific_GoogleMaps_CustomMearsureDistance": {
  "url": "https://www.google.com/maps/@-34.397,150.644,8z",
  "drive": "everyday",
  "scheduled": false,
  "requires": ["canvas", ".U5ELMd", ".Ty7QWe"],
  "timeout": 60000,
  "steps": [
   { "wait": 3000 },
   { "click": "canvas", "button": "right", "via": "desktop" },
   { "wait": 1200 },
   { "click": "[role='menu'] [role='menuitemradio']", "withText": "Measure distance", "via": "desktop" },
   { "wait": 1200 },
   { "click": "canvas", "at": { "dx": 100, "dy": -110 }, "via": "desktop" },
   { "wait": 2000 },
   { "run": true },
   { "wait": 1000 },
   { "expect": { "selector": "#googleMapsCustomMeasureDistanceStyle", "count": 1 } },
   { "expect": { "selector": "#custom-measure-btn", "count": 1 } },
   { "click": "#custom-measure-btn" },
   { "expect": { "selector": "body > svg[style*='19999'][style*='display: block']", "count": 1 } },
   { "click": "body > svg[style*='19999']", "at": { "dx": 0, "dy": 0 } },
   { "click": "body > svg[style*='19999']", "at": { "dx": 100, "dy": -110 } },
   { "wait": 500 },
   { "expect": { "selector": "body > svg[style*='19999'] > g > line", "count": 1 } },
   { "expect": { "selector": "body > svg[style*='19999'] > g > text", "count": 1 } },
   { "expect": { "check": "maps-distance" } }
  ]
 },

