   { "wait": 800 },
   { "expect": { "clipboard": "### Section 1\r\n\r\n- [Routes](https://fixtures.test/article.html#routes)\r\n\r\n### Section 2\r\n\r\n- [Stops](https://fixtures.test/article.html#stops)\r\n\r\n### Section 3\r\n\r\n- [Fares](https://fixtures.test/article.html#fares)" } }
  ]
 },

