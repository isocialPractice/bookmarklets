 "siteSpecific_GitHub_ShowFileSize": {
  "url": "https://github.com/isocialPractice/bookmarklets",
  "scheduled": true,
  "network": [{ "host": "api.github.com", "reason": "file sizes come from GitHub's own REST API" }],
  "requires": ["table", "tr", "body"],
  "timeout": 150000,
  "steps": [
   { "answer": { "host": "api.github.com", "status": 403, "contentType": "application/json; charset=utf-8", "body": "{\"message\":\"API rate limit exceeded for 203.0.113.1. (But here's the good news: Authenticated requests get a higher rate limit.)\",\"documentation_url\":\"https://docs.github.com/rest/overview/rate-limits-for-the-rest-api\"}" } },
   { "wait": "table:has(a[href*='/blob/']) tr:has(th)" },
   { "detach": "table:has(a[href*='/blob/']) tr:has(th)", "as": "headerRow" },
   { "run": true },
   { "run": true },
   { "wait": 7000 },
   { "expect": { "selector": "#fileSizeStyle--__-unlikely_-_name-__--fileSizeStyle", "count": 1 } },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "count": 0 } },
   { "expect": { "selector": "[data-file-size]", "count": 0 } },
   { "expect": { "requests": "api.github.com", "count": 1 } },
   { "attach": "headerRow" },
   { "wait": "#sizeCol--__-unlikely_-_name-__--sizeCol" },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "text": "Size (rate limited)" } },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "visible": true } },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "clear": true } },
   { "expect": { "requests": "api.github.com", "count": 0 } },
   { "answer": { "host": "api.github.com", "pass": true } },
   { "wait": 4000 },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "text": "Size" } },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "visible": true } },
   { "expect": { "selector": "#fileSize-__-unlikely-name-__-fileSize0", "visible": true } },
   { "expect": { "selector": "td[id^='fileSize-__-unlikely-name-__-fileSize']", "matches": "table tr:has(a[href*='/blob/'])" } },
   { "expect": { "requests": "api.github.com", "atMost": 2 } },
   { "detach": "#sizeCol--__-unlikely_-_name-__--sizeCol", "as": "heading" },
   { "detach": "table:has(a[href*='/blob/']) tr:has(th)", "as": "headerRowAgain" },
   { "wait": 5000 },
   { "expect": { "selector": "td[id^='fileSize-__-unlikely-name-__-fileSize']", "matches": "table tr:has(a[href*='/blob/'])" } },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "count": 0 } },
   { "expect": { "requests": "api.github.com", "count": 0 } },
   { "attach": "headerRowAgain" },
   { "wait": 2000 },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "text": "Size" } },
   { "expect": { "selector": "td[id^='fileSize-__-unlikely-name-__-fileSize']", "matches": "table tr:has(a[href*='/blob/'])" } },
   { "expect": { "requests": "api.github.com", "count": 0 } },
   { "click": "table tr a[href$='/tree/main/JSFormatted']:visible" },
   { "wait": 6000 },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "count": 1 } },
   { "expect": { "selector": "td[id^='fileSize-__-unlikely-name-__-fileSize']", "matches": "table tr:has(a[href*='/blob/'])" } },
   { "expect": { "requests": "api.github.com", "atMost": 2 } },
   { "click": "nav[aria-label='Breadcrumbs'] li:nth-child(2) a" },
   { "wait": 6000 },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "count": 1 } },
   { "expect": { "selector": "td[id^='fileSize-__-unlikely-name-__-fileSize']", "matches": "table tr:has(a[href*='/blob/'])" } },
   { "expect": { "requests": "api.github.com", "atMost": 2 } },
   { "answer": { "host": "api.github.com", "status": 403, "contentType": "application/json; charset=utf-8", "body": "{\"message\":\"API rate limit exceeded for 203.0.113.1. (But here's the good news: Authenticated requests get a higher rate limit.)\",\"documentation_url\":\"https://docs.github.com/rest/overview/rate-limits-for-the-rest-api\"}" } },
   { "click": "table tr a[href$='/tree/main/JSFormatted']:visible" },
   { "wait": 8000 },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "text": "Size (rate limited)" } },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "visible": true } },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "clear": true } },
   { "expect": { "requests": "api.github.com", "atMost": 2 } },
   { "viewport": { "width": 1024, "height": 720 } },
   { "wait": 1500 },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "text": "Size (rate limited)" } },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "visible": true } },
   { "expect": { "selector": "#sizeCol--__-unlikely_-_name-__--sizeCol", "clear": true } }
  ]
 },

