{
  "name": "bookmarklets",
  "private": true,
  "description": "A running list of browser bookmarklets, with a Playwright harness that checks each one still works.",
  "license": "MIT",
  "scripts": {
    "test": "npm run test:harness && npm run test:pages && npm run test:gallery && npm run test:install && npm run test:paste-ready && npm run test:bookmarklets",
    "test:harness": "node --test test/harness.test.js",
    "test:pages": "node --test test/pages.test.js",
    "test:gallery": "node --test test/gallery.test.js",
    "test:install": "node --test test/install.test.js",
    "test:paste-ready": "node --test test/paste-ready.test.js",
    "test:bookmarklets": "node test-bm.js --all",
    "test:scheduled": "node test-bm.js --scheduled",
    "test:site": "node --test test/site.test.js",
    "install-page": "node make-install-page.js",
    "shorts": "node test-bm.js --all --short"
  },
  "devDependencies": {
    "playwright": "1.65.0",
    "to-explorer": "1.1.0"
  }
}
