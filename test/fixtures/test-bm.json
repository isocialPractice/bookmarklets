{
 "$schema": "../../test-bm.schema.json",

 "fixture_Pass_AddsAPanel": {
  "url": "fixture:article.html",
  "steps": [
   { "run": true },
   { "expect": { "selector": "#panel--__-unlikely_-_name-__--fixturePassAddsAPanel", "count": 1 } },
   { "expect": { "selector": "#panel--__-unlikely_-_name-__--fixturePassAddsAPanel", "text": "the fixture ran" } },
   { "run": true },
   { "expect": { "selector": "#panel--__-unlikely_-_name-__--fixturePassAddsAPanel", "count": 0 } }
  ]
 },

 "fixture_PageNoise_PageLogsItsOwnError": {
  "url": "fixture:self-test-noisy.html",
  "steps": [
   { "run": true },
   { "expect": { "selector": "#target", "text": "the fixture ran" } }
  ],
  "settle": 1000
 },

